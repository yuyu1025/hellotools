---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/site';
---
<BaseLayout title={`页面不存在 · ${SITE_NAME}`} description="这个地址没有内容。" noindex>
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>这里什么都没有</h1>
    <p class="lede">链接可能变了，或者项目已经下架。回首页看看，或者直接搜。</p>
    <div class="detail-actions">
      <a class="button primary" href="/">返回首页</a>
      <a class="button" href="/tools">搜索全部工具</a>
    </div>
  </section>
</BaseLayout>
