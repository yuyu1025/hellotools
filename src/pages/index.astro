---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolRow from '../components/ToolRow.astro';
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL } from '../lib/site';
import {
  getMeta,
  getTools,
  groupedByCategory,
  rank,
  byRecent,
  byFirstSeen,
  categoryLabel,
  daysSincePush,
} from '../lib/data';
import { formatStars, formatDate } from '../lib/format';
import { CATEGORY_IDS } from '../lib/categories.mjs';

const tools = await getTools();
const meta = await getMeta();
const groups = await groupedByCategory();

// 精选：编辑标记优先，不足时按「星数 × 新鲜度」补齐。只从可安装的应用里挑，
// 开发库单独有分类页，不占首页。
const picks = tools
  .filter((t) => t.featured)
  .concat(
    tools
      .filter((t) => !t.featured && t.category !== 'library' && (t.state === 'live' || t.state === 'busy'))
      .sort((a, b) => rank(b) - rank(a))
      .slice(0, 24),
  )
  .slice(0, 6);

const recentAdded = [...tools].sort(byFirstSeen).slice(0, 8);
const recentActive = tools
  .filter((t) => t.state === 'live' && t.category !== 'library')
  .sort(byRecent)
  .slice(0, 8);

const liveShare = Math.round(((meta.byState.live + meta.byState.busy) / meta.total) * 100);
const appCount = tools.filter((t) => t.category !== 'library').length;
const libCount = tools.filter((t) => t.category === 'library').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/tools?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} canonicalPath="/" jsonLd={jsonLd}>
  <section class="hero">
    <p class="eyebrow">开源工具导航</p>
    <h1>不追热点，只收你能装上的开源工具</h1>
    <p class="lede">
      从 HelloGitHub 的历年推荐里筛出的 {meta.total} 个仓库，按用途分成 {CATEGORY_IDS.length} 类。
      每个条目都附上实时星数、许可证、最近提交时间，停更和归档的会被标出来，省得你点进去才发现是个坑。
    </p>
    <ul class="stat-row">
      <li><span class="stat-value">{appCount}</span><span class="stat-label">可直接使用的软件</span></li>
      <li><span class="stat-value">{libCount}</span><span class="stat-label">开发库</span></li>
      <li><span class="stat-value">{liveShare}%</span><span class="stat-label">仍在维护</span></li>
      <li><span class="stat-value">{formatDate(meta.updatedAt)}</span><span class="stat-label">数据更新</span></li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>先看这几个</h2>
      <a class="more" href="/tools">全部 {meta.total} 个 →</a>
    </div>
    <div class="tool-grid">
      {picks.map((tool) => <ToolCard tool={tool} categoryLabel={categoryLabel(tool.category)} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>按用途找</h2>
      <a class="more" href="/categories">分类说明 →</a>
    </div>
    <div class="category-grid">
      {groups.map((group) => (
        <a class="category-tile" href={`/c/${group.id}`}>
          <div class="category-tile-head">
            <span class="category-tile-name">{group.label}</span>
            <span class="category-tile-count">{group.tools.length}</span>
          </div>
          <span class="category-tile-blurb">{group.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近收录</h2>
      <a class="more" href="/recent">按时间看全部 →</a>
    </div>
    <div class="tool-list">
      {recentAdded.map((tool) => <ToolRow tool={tool} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>这两天还在提交的</h2>
      <a class="more" href="/tools?sort=active">按活跃度排序 →</a>
    </div>
    <div class="tool-list">
      {recentActive.map((tool) => <ToolRow tool={tool} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>一点说明</h2>
    </div>
    <div class="prose">
      <p>
        「活跃」只代表仓库半年内有提交，「停更」也不等于不能用——很多小工具写完就该结束了，
        {meta.byState.stale + meta.byState.archived} 个停更或归档的项目照样留在库里，只是标了出来。
        星数取的是 GitHub 当前值，不是收录时的快照，所以老项目的排名会随时间变化。
      </p>
      <p class="faint">
        共 {meta.total} 条记录，其中 {meta.byState.live} 个活跃、{meta.byState.busy} 个繁忙、
        {meta.byState.dormant} 个缓更。数据每天由 GitHub Actions 重新拉取一次。
      </p>
    </div>
  </section>
</BaseLayout>
