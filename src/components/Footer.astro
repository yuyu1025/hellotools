---
import { SITE_NAME, REPO_URL, DATA_SOURCE } from '../lib/site';
import { getMeta } from '../lib/data';

const meta = await getMeta();
const year = new Date().getUTCFullYear();
const updated = meta.updatedAt.slice(0, 10);
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-bottom">
      <span>
        {SITE_NAME} © {year} · 数据来自
        <a href={DATA_SOURCE} rel="noopener noreferrer" target="_blank">HelloGitHub</a>
        与 GitHub API，最近更新 {updated}
      </span>
      <nav class="footer-links" aria-label="页脚">
        <a href="/tools">全部工具</a>
        <a href="/categories">分类</a>
        <a href="/recent">新收录</a>
        <a href="/about">关于</a>
        <a href={REPO_URL} rel="noopener noreferrer" target="_blank">源码</a>
      </nav>
    </div>
  </div>
</footer>
